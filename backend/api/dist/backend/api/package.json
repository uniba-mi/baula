{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "app.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copyFiles",
    "copyFiles": "copyfiles pm2.config.js package.json dist/backend/api && copyfiles -u 1 staticdata/* dist/backend/api/staticdata && copyfiles -u 1 src/certs/* dist/backend/api/src && copyfiles -u 1 -e '**/*.ts' src/database/* dist/backend/api/src/",
    "startApi": "nodemon ./src/app.ts",
    "startCronjob": "nodemon ./src/cron/cron-job.ts",
    "generateDB": "npx prisma generate --schema ./src/database/schema.prisma",
    "updateDB": "npx prisma db push --schema ./src/database/schema.prisma",
    "resetDB": "npx prisma migrate reset --skip-generate --schema ./src/database/schema.prisma",
    "startStudio": "npx prisma studio --schema ./src/database/schema.prisma",
    "build:test": "set NODE_ENV=test && npm run build",
    "build:prod": "set NODE_ENV=production && npm run build"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@node-saml/passport-saml": "^5.0.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.8.4",
    "camaro": "^6.2.0",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.1",
    "express-jwt": "^8.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^6.3.0",
    "mongoose": "^8.0.4",
    "morgan": "^1.10.0",
    "mysql": "^2.18.1",
    "node-cron": "^3.0.3",
    "nodemon": "^3.0.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "puppeteer": "^23.10.1",
    "puppeteer-extra": "^3.3.6",
    "redis": "^5.8.2",
    "validator": "^13.9.0",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/express-session": "^1.18.0",
    "@types/morgan": "^1.9.3",
    "@types/node": "^20.17.32",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/passport-saml": "^1.1.7",
    "@types/validator": "^13.7.12",
    "copyfiles": "^2.4.1",
    "prisma": "^5.8.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
