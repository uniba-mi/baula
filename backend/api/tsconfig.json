{
  "compilerOptions": {
    "declaration": true,
    "rootDir": "../../",
    "paths": {
      "@interfaces/*": ["../../interfaces/*"]
    },
    "target": "ES2019",                                  /* Set the JavaScript language version for emitted JavaScript and include compatible library declarations. */
    "module": "CommonJS",                                /* Specify what module code is generated. */
    "lib": ["ES2019"],
    "esModuleInterop": true,                             /* Emit additional JavaScript to ease support for importing CommonJS modules. This enables 'allowSyntheticDefaultImports' for type compatibility. */
    "resolveJsonModule": true,
    "outDir": "./dist",                               
    "forceConsistentCasingInFileNames": true,            /* Ensure that casing is correct in imports. */                                /* Type declaration files to be included in compilation. */
    /* Type Checking */
    "strict": true,                                      /* Enable all strict type-checking options. */

    /* Completeness */
    "skipLibCheck": true
  },
  /* Dev-only (nodemon/ts-node, see startApi + startCronjob). Type checking on
     every require blocks the event loop for ~15s at startup, which is longer
     than the 5s serverSelectionTimeoutMS of the Mongo connection opened in
     src/database/mongo.ts - the connection then times out before the loop is
     free again. Transpiling only keeps startup at ~2s. `tsc` ignores this key,
     so `npm run build` stays the full type-check gate. */
  "ts-node": {
    "transpileOnly": true
  },
  "include": ["./src/**/*", "../../interfaces/*.ts"],
  "exclude": ["./node_modules", "./dist"]
}
