{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "app.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copyFiles",
    "copyFiles": "copyfiles package.json dist/backend/api && copyfiles -u 1 staticdata/* dist/backend/api/staticdata && copyfiles -u 1 staticdata/**/* dist/backend/api/staticdata && copyfiles -u 1 src/certs/* dist/backend/api/src && copyfiles -u 1 -a -e '**/*.ts' src/database/* dist/backend/api/src/ && copyfiles -a -u 2 src/database/.env dist/backend/api/src/database && copyfiles -a environment/* dist/backend/api/",
    "startApi": "nodemon ./src/server.ts",
    "startCronjob": "nodemon ./src/shared/utils/cron-job.ts",
    "generateDB": "npx prisma generate --schema ./src/database/schema.prisma",
    "updateDB": "npx prisma db push --schema ./src/database/schema.prisma",
    "resetDB": "npx prisma migrate reset --skip-generate --schema ./src/database/schema.prisma",
    "startStudio": "npx prisma studio --schema ./src/database/schema.prisma",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --detectOpenHandles",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js}\"",
    "check-format": "prettier --check \"src/**/*.{ts,js}\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@node-saml/passport-saml": "^5.1.0",
    "@prisma/client": "^6.18.0",
    "axios": "^1.12.2",
    "camaro": "^6.2.3",
    "compression": "^1.7.4",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-jwt": "^8.5.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "mongoose": "^8.20.0",
    "morgan": "^1.10.1",
    "mysql": "^2.18.1",
    "node-cron": "^4.2.1",
    "nodemon": "^3.1.10",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "puppeteer": "^25.2.0",
    "puppeteer-extra": "^3.3.6",
    "redis": "^6.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.15",
    "winston": "^3.18.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/passport-saml": "^1.1.7",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.3",
    "copyfiles": "^2.4.1",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "prettier": "^3.3.3",
    "prisma": "^6.18.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
