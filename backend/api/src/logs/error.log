     {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"Selbststudium\",\n                hours: 135\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"Präsenzzeit\",\n                hours: 45\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"Präsenzzeit\",\n                hours: 45\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"Selbststudium\",\n                hours: 135\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"Präsenzzeit\",\n                hours: 45\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"Selbststudium\",\n                hours: 135\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n              {\n                type: \"\",\n                hours: NaN\n              },\n        