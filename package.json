  "scripts": {
    "startProdDocker": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build --force-recreate",
    "startLocalDocker": "docker compose -f docker-compose.yml -f docker-compose.override.yml up -d --build --force-recreate",
    "stopDocker": "docker compose down -v",
